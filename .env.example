# Copy to .env and fill in the block you need.
# Never commit .env — it's in .gitignore.

# --- Backend selector ---
REGISTRATION_BACKEND=json   # json | airtable | runsignup | raceroster

# --- Airtable ---
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=

# --- RunSignup ---
RUNSIGNUP_API_KEY=
RUNSIGNUP_API_SECRET=
# 2027 registrations live in race 89412 (2026 was 83604 - still used for 2026
# results and photos, which have their own IDs in results.py / photos.py).
RUNSIGNUP_RACE_ID=89412
# Set to the 2027 Half Marathon event ID once RunSignup assigns it.
RUNSIGNUP_EVENT_ID=

# --- RaceRoster ---
RACEROSTER_PARTICIPANTS_URL=
RACEROSTER_TOKEN=

# --- Volunteer sign-up (POST /volunteer) ---
# Who gets an email for each sign-up. Leave empty to only save to volunteers.json.
VOLUNTEER_TO=
VOLUNTEER_FROM=info@santafehalfmarathon.com
# Optional: store sign-ups somewhere persistent (Render's disk resets on deploy).
VOLUNTEERS_FILE=
# Max sign-ups per connection per window (seconds).
VOLUNTEER_RATE_LIMIT=10
VOLUNTEER_RATE_WINDOW=3600
# Optional Google reCAPTCHA v3. When the secret is set, the form must send recaptcha_token.
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_ACTION=volunteer
# Outgoing mail for the notification (e.g. Brevo SMTP relay).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_STARTTLS=true

# --- GitHub MCP server (optional, for the claude CLI — see GITHUB_MCP_SETUP.md) ---
# Fine-grained PAT from https://github.com/settings/personal-access-tokens
GITHUB_PAT=

# --- Server transport ---
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8000
