# Copy to .env and fill in the block you need.
# Never commit .env — it's in .gitignore.

# --- Backend selector ---
REGISTRATION_BACKEND=json   # json | airtable | runsignup | raceroster

# --- Airtable ---
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=

# --- RunSignup ---
RUNSIGNUP_API_KEY=
RUNSIGNUP_API_SECRET=
RUNSIGNUP_RACE_ID=83604
RUNSIGNUP_EVENT_ID=1056101

# --- RaceRoster ---
RACEROSTER_PARTICIPANTS_URL=
RACEROSTER_TOKEN=

# --- Server transport ---
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Optional SMTP settings for volunteer notifications
# SMTP_HOST: your SMTP server (eg. smtp.sendgrid.net)
# SMTP_PORT: server port (587 for STARTTLS or 465 for SSL)
# SMTP_USER / SMTP_PASS: credentials if required
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_STARTTLS=true

# Volunteer email envelope
VOLUNTEER_FROM=info@santafehalfmarathon.com
VOLUNTEER_TO=KerriCottle@gmail.com

# Optional: forward volunteer signups to another API (POST receives JSON)
VOLUNTEER_FORWARD_URL=

# Simple rate limiting for /volunteer: number of submissions per window
# (defaults: 10 per 3600 seconds). Set lower for stricter limits.
VOLUNTEER_RATE_LIMIT=10
VOLUNTEER_RATE_WINDOW=3600
# Optional: Redis URL for production-rate limiting (e.g. redis://user:pass@host:6379/0)
REDIS_URL=

# Optional: Google reCAPTCHA secret (verify tokens server-side). If set,
# clients must send `recaptcha_token` with the POST body.
RECAPTCHA_SECRET=

# Optional: when set to 'airtable' or 'json', persist volunteers to that backend
# - 'airtable' requires AIRTABLE_TOKEN, AIRTABLE_BASE_ID, AIRTABLE_TABLE
# - 'json' appends a volunteer record to the local registrations.json
VOLUNTEER_PERSIST_BACKEND=
